{
  "name": "Link Vault",
  "short_name": "Link Vault",
  "description": "Save and browse links from Instagram, LinkedIn, and anywhere else, synced via Google Drive.",
  "start_url": "/linkvault/",
  "scope": "/linkvault/",
  "display": "standalone",
  "background_color": "#EEF0F2",
  "theme_color": "#2F6F5E",
  "icons": [
    { "src": "/linkvault/icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/linkvault/icons/icon-512.png", "sizes": "512x512", "type": "image/png" }
  ],
  "share_target": {
    "action": "/linkvault/share-target.html",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  }
}
