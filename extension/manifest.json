{
  "manifest_version": 3,
  "name": "Link Vault",
  "description": "Save links from Instagram, LinkedIn, and anywhere else, synced to your Link Vault dashboard via Google Drive.",
  "version": "1.0.0",
  "key": "",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["identity", "contextMenus", "storage", "activeTab"],
  "host_permissions": ["https://www.googleapis.com/*"],
  "oauth2": {
    "client_id": "1018364510823-gou19t64bc6ge649s12aeos4uh8ps45e.apps.googleusercontent.com",
    "scopes": ["https://www.googleapis.com/auth/drive"]
  }
}
